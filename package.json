{
  "name": "self-heal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "description": "Self-healing agent: on a caught error, an in-Worker coding agent clones the repo, fixes the bug, and pushes — entirely on Cloudflare.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:create": "wrangler d1 create self-heal-db",
    "db:migrate": "wrangler d1 migrations apply self-heal-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply self-heal-db",
    "app:promote": "bash scripts/promote-app-key.sh",
    "db:list": "wrangler d1 migrations list self-heal-db --remote",
    "lint": "oxlint"
  },
  "dependencies": {
    "@cloudflare/computer": "0.2.1",
    "@platformatic/vfs": "^0.4.0",
    "ai": "^7.0.66",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@oxlint/plugins": "1.78.0",
    "oxlint": "1.78.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.1"
  }
}
