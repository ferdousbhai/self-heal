{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "self-heal",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],

  // isomorphic-git inflates packfiles out of SQLite on the Worker's own CPU,
  // and the agent loop runs many tool calls in one request. The default 30s
  // CPU budget is not enough for either.
  "limits": {
    "cpu_ms": 300000
  },

  "vars": {
    // owner/repo that errors are fixed in (can be overridden per request).
    "REPO": "ferdousbhai/summon-ghost",
    "DEFAULT_BRANCH": "master",
    // DeepSeek V4 Pro via Workers AI — supports function calling, which the
    // agent loop requires, and a 1M context window.
    "MODEL": "@cf/deepseek-ai/deepseek-v4-pro-0813",
    // Admission control (defaults; overridable).
    "COOLDOWN_HOURS": "24",
    "MAX_RUNS_PER_HOUR": "5"
  },

  // Authenticated by the platform — no API token, which is why self-heal has
  // no CLOUDFLARE_API_KEY secret.
  "ai": {
    "binding": "AI"
  },

  "workflows": [
    {
      "name": "fix-workflow",
      "binding": "FIX_WORKFLOW",
      "class_name": "FixWorkflow"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "FIX_AGENT", "class_name": "FixAgent" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FixAgent"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "self-heal-db",
      "database_id": "40f86fb7-177c-4b7b-b2a8-e6576cdaa467",
      // Applied with `pnpm db:migrate`, which tracks what has already run.
      // Applying a single file by hand silently skips later migrations.
      "migrations_dir": "db/migrations"
    }
  ]
}
